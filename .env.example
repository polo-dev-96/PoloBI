# Polo BI - Environment Variables
# Copy this file to .env and fill in your credentials

# API Key para Milvus (OBRIGATÓRIO)
# Obtenha em: https://app.milvus.com.br → Configurações → API
MILVUS_API_KEY=your_api_key_here

# Ambiente (development ou production)
NODE_ENV=development

# Porta do servidor
PORT=5000

# ElevenLabs (opcional; sem essas credenciais, usa a voz do navegador)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Opcional: modelo de voz; o padrão é eleven_multilingual_v2
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Opcional: velocidade da voz, entre 0.7 e 1.2 (1 é a velocidade normal)
ELEVENLABS_VOICE_SPEED=0.9
